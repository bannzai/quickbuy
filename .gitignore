# 審査の連絡先 (氏名・電話番号・メールアドレス) は個人情報のためコミットしない (fastlane deliver が読む場所)
fastlane/metadata/review_information/

# Firebase のクライアント設定ファイル (API キーを含む。Firebase を使う時もコミットせず、CI では secret から復元する)
lib/firebase_options.dart
**/GoogleService-Info.plist
**/google-services.json

# Android (着手時に使う。ビルド成果物とローカル設定)
.gradle/
local.properties
*.keystore
*.jks

# bundler のローカルインストール先 (~/.bundle/config の path=vendor/bundle が作る)
vendor/bundle/
