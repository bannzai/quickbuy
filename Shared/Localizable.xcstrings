    "%@\n次の知らせは %@ です\n通知が許可されていません\n設定アプリで Quick Buy の通知を許可すると届きます" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nDie nächste Benachrichtigung kommt am %@\nMitteilungen sind nicht erlaubt\nErlaube Mitteilungen von Quick Buy in den Einstellungen, um sie zu erhalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
