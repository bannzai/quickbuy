        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nLa próxima notificación es el %@\nLas notificaciones no están permitidas\nActiva las notificaciones de Quick Buy en Ajustes para recibirlas"
